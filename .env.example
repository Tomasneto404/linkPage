# PostgreSQL is used when DATABASE_URL is set. Without it, SQLite remains
# available for legacy installations and migration tooling.
DATABASE_URL=postgresql://linkpage:change-me@localhost:5432/linkpage
# Import an existing DATA_DIR/links.db only into an empty PostgreSQL database.
# The original SQLite file and existing filesystem uploads are preserved.
MIGRATE_SQLITE=0
# DATA_DIR=./data
# PORT=3001
# For Compose, choose a strong password before starting the database:
POSTGRES_PASSWORD=change-me
