{
  "name": "linkpage",
  "version": "1.1.0",
  "description": "An enterprise-ready self-hosted link page to share links with collaborators or clients.",
  "main": "src/server.js",
  "license": "AGPL-3.0-or-later",
  "files": [
    "src/",
    "public/",
    "scripts/",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.browser.js\"",
    "security:scan": "trivy fs --severity CRITICAL --exit-code 1 --ignore-unfixed .",
    "security:image": "trivy image --severity CRITICAL --exit-code 1 --ignore-unfixed linkpage:local"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "swagger-ui-dist": "^5.33.1",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
